        }
      }
    },
    "Il tuo supporto è fondamentale per coprire i costi di gestione e sostenere il futuro di In Orario. Buon viaggio!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your support is fundamental to cover running costs and support the future of In Orario. Have a nice trip!"
