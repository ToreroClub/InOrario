    },
    "Grazie per il supporto: tutte le novità e i widget sono già attivi per te" : {

    },
    "Guasti sulla linea, interruzioni improvvise e comunicazioni importanti sui trasporti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
