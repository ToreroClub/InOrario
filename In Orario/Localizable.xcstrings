    "Il Progetto In Orario" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The In Orario Project"
          }
        }
      }
    },
    "Il server monitora la tua tratta abituale e in caso di cancellazioni o gravi ritardi riceverai un'alternativa." : {

    },
    "Il treno non ha ancora lasciato la stazione di partenza." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
